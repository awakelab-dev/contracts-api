PORT=4000
NODE_ENV=development

# Auth
JWT_SECRET=change-me
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
# (opcional) Si prefieres guardar un hash bcrypt en lugar de password plano:
# ADMIN_PASSWORD_HASH=$2a$10$...
AUTH_COOKIE_NAME=contracts_session
AUTH_SESSION_HOURS=8

# CORS (lista separada por comas; usa * para reflejar cualquier origin)
CORS_ORIGIN=http://localhost:5173

DB_HOST=your-aurora-endpoint
DB_USER=your-db-user
DB_PASSWORD=your-db-password
DB_NAME=contracts_app
DB_PORT=3306

# OpenAI (Matching IA)
OPENAI_API_KEY=your-openai-api-key
OPENAI_MATCH_MODEL=gpt-4o-mini
OPENAI_MATCH_PROMPT_VERSION=1
